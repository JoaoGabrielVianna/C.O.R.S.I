# Production build defaults. Loaded by Vite when NODE_ENV=production
# (i.e. during `npm run build`).
#
# This file is committed and intentionally empty so the default bundle
# uses same-origin requests. EasyPanel (and any other host) overrides
# the value at build time via the Dockerfile ARG:
#
#   docker build --build-arg VITE_API_URL=https://api.corsi.dev ./frontend
#
# Whatever the build process sets in process.env wins over this file.
VITE_API_URL=
