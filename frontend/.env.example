# ==========================================
# API CONFIGURATION
# ==========================================

# Base URL used in production builds
# Leave empty for local Vite proxy
VITE_API_URL=

# Examples:
# Local:
# VITE_API_URL=
# Production:
# VITE_API_URL=https://api.corsi.dev

# ==========================================
# Notes
# ==========================================
# Empty value → uses same origin (relative paths). Locally that means
#   Vite's dev proxy forwards /finance, /health, /openapi.yaml and
#   /swagger to localhost:8080 (see vite.config.ts).
# Production → set the backend's public URL, e.g. https://api.corsi.dev.
#   The value is baked into the JS bundle at build time, so rebuild
#   the frontend image whenever this changes.
# Never commit secrets here. This file is committed; .env.local is not.
# ==========================================

# ==========================================
# DEV TUNNEL (opcional)
# ==========================================
# Host público extra aceito pelo dev server do Vite. Necessário só
# quando o fluxo OAuth exige uma origem pública (túnel). Vazio em uso
# normal: localhost e 127.0.0.1 já são aceitos por padrão.
# VITE_DEV_ALLOWED_HOST=seu-tunel.exemplo.dev
