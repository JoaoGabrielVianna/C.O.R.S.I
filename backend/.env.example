# HTTP
# In containers, PORT is honored by the entrypoint and rewritten to HTTP_ADDR.
# Locally, HTTP_ADDR is the authoritative setting.
HTTP_ADDR=:8080
PORT=8080

# Postgres
POSTGRES_DSN=postgres://corsi:corsi@localhost:55432/corsi?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE=30m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Observability
OTEL_SERVICE_NAME=corsi
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=false

# Identity — the single operator
#
# THE PASSWORD IS NEVER CONFIGURATION. What goes below is an argon2id
# VERIFIER, which is what the server needs and the only thing it can use;
# the password itself is typed on your own machine and never leaves it:
#
#   go run ./cmd/corsi-passwd          # prompts twice, no echo
#
# There is no AUTH_ENABLED and no way to turn this off. A process with no
# credential refuses to boot rather than serving everyone — an
# unauthenticated C.O.R.S.I. on a public hostname is a worse failure than a
# container that will not start.
#
# The hash below is for LOCAL DEVELOPMENT ONLY and its password is
# `corsi-dev-password`. It is in version control, so it protects nothing.
# Production supplies its own through the deployment's environment.
AUTH_EMAIL=dev@corsi.local
#
# ── THE SINGLE QUOTES ARE LOAD-BEARING ────────────────────────────────
#
# `make run` loads this file with `set -a; source .env; set +a`, and a PHC
# string is made of `$` segments. Unquoted, the shell expands `$argon2id`,
# `$v` and `$m` to nothing and the server receives `=19=65536,t=3,p=2` —
# a verifier that fails to parse, which fails the BOOT, which reads as
# "identity is broken" rather than "the example was copied verbatim".
#
# Single quotes, not double: double quotes still expand `$`.
# TestEnvExampleSurvivesShellLoading is the regression.
AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$gaIR3tdprD7nZRpje023tQ$xhZWBz5OLl8y3NVGnYvfraGibtsa8ihGuIxtyI2CqHM'
# Absolute session lifetime, not idle: a sliding window lets a stolen
# cookie renew itself forever.
AUTH_SESSION_TTL=168h
# Drops `Secure` and the `__Host-` cookie prefix so a session survives
# plain http://localhost. FALSE in production, which is the default, so a
# deployment gets the safe behaviour by configuring nothing.
AUTH_COOKIE_INSECURE=true

# Workspace context is read from the X-Workspace-Id header, and it answers
# WHICH TENANT rather than WHO: it is not authentication and must never be
# treated as any. Nothing reaches it without a session — see
# internal/platform/identity.

# Workspace hardening
# When false (default), missing X-Workspace-Id falls back to a dev sentinel
# UUID and the response carries `X-Workspace-Source: dev-sentinel`. Safe for
# local development.
# When true, missing X-Workspace-Id returns 401 workspace_required. REQUIRED
# IN PRODUCTION so the sentinel can never be reached by an unauth'd request.
WORKSPACE_REQUIRE_HEADER=false

# Secrets at rest (chat module)
# AES-256-GCM key used to seal LLM provider API keys before they touch
# Postgres. Generate with:
#
#   openssl rand -base64 32
#
# Leaving it blank is allowed — the API boots, logs a warning, and refuses
# to store or read provider credentials with a 503. Every other module is
# unaffected.
#
# Rotating this key invalidates every stored credential: there is no
# envelope re-wrap, so rotation means re-entering the provider keys in the
# UI. Back it up wherever you keep POSTGRES_DSN.
SECRETS_KEY=

# Agents · internal diagnostic tools
# When true, the agent tool catalogue includes the built-in diagnostics —
# today only `system.echo`, which returns the text it was given and exists
# to exercise tool calling end to end.
#
# LEAVE THIS FALSE IN PRODUCTION. It is not a display switch: when off, the
# tool is absent from the registry, so it cannot be listed, cannot be
# authorized, and a grant that survives from a previous deploy resolves to
# nothing and is reported as stale.
#
# Set it to true for local development, where exercising the machinery is
# the point.
CHAT_ENABLE_INTERNAL_TOOLS=false

# Finance · the zone a reporting PERIOD is cut in.
#
# Which instant "hoje" starts at, and where "este mês" begins and ends, for
# every figure an agent reports. The Finance screens have always cut their
# windows in the BROWSER's zone, so a month has meant the operator's local
# month; a conversation has no browser, and nothing in a turn tells a model
# what today is, so the boundaries are resolved here instead.
#
# UTC would be wrong for three hours every night rather than obviously
# wrong, which is why the default is the operator's zone and not the
# neutral-looking one. A name the runtime does not recognise FAILS THE BOOT:
# a deployment that cannot say what timezone it reports in should not be
# answering questions about money.
FINANCE_TIMEZONE=America/Sao_Paulo

# Agents · provider-side prompt caching.
#
# OPT-OUT, and the polarity is deliberate: caching changes how a provider
# BILLS the stable head of a prompt, never what the model reads (proved on
# the bytes in internal/chat/adapters/llm/cache_control_test.go). So the
# conservative value is the cheap one, and a deployment that configures
# nothing should get it.
#
# Set to true to send the pre-1.5.0 request body — no marker, no content
# blocks, no cache_control — without a code deploy. It is the kill switch
# for a gateway regression on an external boundary this project does not
# control.
CHAT_DISABLE_PROMPT_CACHE=false

# ── Meta Threads integration ───────────────────────────────────────────
# The deployment's Meta app, from developers.facebook.com. These identify
# THIS INSTALLATION to Meta; a workspace's own user token is obtained by
# OAuth and stored sealed in meta_threads.connections, never here.
#
# Both values come from the app's THREADS use case — "ID do app do Threads"
# and "Chave secreta do app do Threads" — not from the app's general
# Facebook credentials. The integration talks only to threads.net and
# graph.threads.net, which reject the generic pair.
#
# All three empty is a valid, running deployment: the capabilities are
# registered, the Integrations card explains what is missing, and every
# attempt to connect refuses with an actionable 503.
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=

# Where Meta sends the browser back. It is a FRONTEND url — the SPA reads
# the code and hands it to POST /integrations/meta-threads/connection; no
# backend route receives this callback.
#
# It must match the "Redirecionar URLs de retorno de chamada" field in the
# Meta console byte for byte, and it must be the origin the browser is
# actually using: the card derives its own redirect_uri from
# window.location, and a mismatch between the two fails the token exchange.
META_THREADS_REDIRECT_URI=https://<seu-host>/app/settings/integrations
